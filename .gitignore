# Local env
.env
.env.local
.env.*.local

# Cache
.vite
.eslintcache

# Vite leaks these on Windows when killed mid-run; sandbox can't unlink them.
*.config.ts.timestamp-*.mjs
*.tsbuildinfo

# Screenshots from local dev (keep committed week markers)
screenshots/scratch/

# Sandbox scratch files (cannot be deleted from inside the VM)
.bashtest.txt
.synctest

.vercel
.env*.local

# alpha-pass-topdown.mjs source backups (reversible, not committed)
*.png.bak

# P1-6 repo-cleanup — local scratch/junk that kept landing at the repo root
*.PAYPAL-SLICE
*.bundle
*.tmp
.audit-probe
.mobile-test*.txt
nul
test-results/
merchant-page.html
products-prod.json

# Local-only developer artifacts (notes, push helpers, scratch specs) — kept
# out of the tree so the host /goal runner's collision guard sees a clean repo.
.claude/
CLAUDE.md
*.bat
HANDOFF-*.md
OMS-GOAL.md
*-LOG.md
tests/e2e/auto-dig-*.spec.ts

# /goal runner sentinels (local run state, never source)
.goal-status/

# Raw incoming AI renders (slotted via scripts/slot-topdown.mjs, never committed raw)
scripts/incoming/*
!scripts/incoming/.gitkeep
