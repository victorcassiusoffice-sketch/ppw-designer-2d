{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/create-checkout-session.ts": { "maxDuration": 10 },
    "api/stripe-webhook.ts": { "maxDuration": 10 },
    "api/merchants/signup.ts": { "maxDuration": 15 },
    "api/stripe-connect/webhook.ts": { "maxDuration": 15 },
    "api/admin-router.ts": { "maxDuration": 15 },
    "api/paypal-router.ts": { "maxDuration": 15 },
    "api/products.ts": { "maxDuration": 10 },
    "api/healthcheck.ts": { "maxDuration": 5 }
  },
  "rewrites": [
    { "source": "/api/createPaypalOrder", "destination": "/api/paypal-router" },
    { "source": "/api/capturePaypalOrder", "destination": "/api/paypal-router" },
    { "source": "/api/paypal-webhook", "destination": "/api/paypal-router" },
    { "source": "/api/paypal/(.*)", "destination": "/api/paypal-router" },
    { "source": "/api/admin/(.*)", "destination": "/api/admin-router" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
