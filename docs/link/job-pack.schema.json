          "required": [
            "label",
            "kind"
          ],
          "additionalProperties": false
        },
        "requester": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "landlord",
                "agent",
                "syndic",
                "committee",
                "developer",
                "company"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "type",
            "label"
          ],
          "additionalProperties": false
        },
        "trade": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "urgency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "preferredDates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "quantities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "qty": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 1000000
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "planRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
