          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
