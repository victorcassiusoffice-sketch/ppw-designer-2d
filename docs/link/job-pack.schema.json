            "app",
            "label"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "site": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "kind": {
              "enum": [
                "lot",
                "common-part",
                "house",
                "build-site"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
